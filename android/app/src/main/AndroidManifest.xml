<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Lo dispara AlarmManager a la hora programada; nunca lo lanza otra app. -->
        <receiver
            android:name=".AlarmReceiver"
            android:exported="false" />

        <!-- Reprograma las alarmas nativas tras un reinicio (ver BootReceiver.java). -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Lo arranca AlarmReceiver; ver AlarmService.java. Reproduce el
             sonido de la alarma él mismo (tono/canción/radio), así que
             "mediaPlayback" es el tipo correcto —a diferencia de
             "shortService", que Android limita a unos 3 minutos de vida,
             insuficiente para una alarma que puede sonar mucho más si nadie
             la para—. -->
        <service
            android:name=".AlarmService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Programar la alarma a una hora exacta con setAlarmClock. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- La notificación de pantalla completa que despierta el dispositivo. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Abrir la pantalla de alarma con el móvil DESBLOQUEADO y en uso. Con la
         pantalla bloqueada basta la notificación de pantalla completa, que
         abre el sistema por su cuenta; desbloqueado, Android la degrada a
         notificación flotante y el startActivity de AlarmService choca con las
         restricciones de arranque de actividades en segundo plano. Tener este
         permiso es una de las exenciones oficiales de esa restricción. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Reprogramar tras reiniciar el dispositivo. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- El wake lock breve de AlarmReceiver y el largo de motor/vigilia.js. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Para que el sistema no mate la app de fondo antes de que llegue la
         hora de una alarma. No cubre los ajustes propios de cada fabricante
         (el "autoarranque" de ColorOS, por ejemplo): esto solo es la parte
         de Android en sí. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- El servicio en primer plano de AlarmService, y su tipo concreto. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
</manifest>
